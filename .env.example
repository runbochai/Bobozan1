# Copy your Firebase Web App configuration here. Never use service-account private keys.
# VITE_FIREBASE_* names are also supported; authDomain defaults to <projectId>.firebaseapp.com.
VITE_API_KEY=your-firebase-web-api-key
VITE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_PROJECT_ID=your-project
VITE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_APP_ID=your-firebase-app-id
